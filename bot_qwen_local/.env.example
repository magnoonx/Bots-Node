# ==========================================
# CONFIGURACIÓN LOCAL (100% OFFLINE / PRIVADO)
# ==========================================
LOCAL_MODE=true

# Motor de Inferencia LLM Local (Ollama / LocalAI / LM Studio)
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.1:8b

# Motor de Transcripción de Audio (Whisper Local)
LOCAL_STT_URL=http://127.0.0.1:8000/v1/audio/transcriptions
LOCAL_WHISPER_MODEL=small

# Almacenamiento Local de Calendario y Registros
LOCAL_CALENDAR=true

# ==========================================
# FALLBACKS EN LA NUBE (OPCIONALES)
# ==========================================
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
